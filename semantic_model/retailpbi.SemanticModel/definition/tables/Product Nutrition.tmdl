	column 'Latest Observation'
		dataType: boolean
		isHidden
		lineageTag: 3f7c1a52-6d1e-4c0a-9a53-0b2d7e5c8a11
		summarizeBy: none
		sourceColumn: is_latest_observation

	partition 'Product Nutrition' = m
		mode: import
		source =
				let
				    Source =
				        Parquet.Document(
				            File.Contents(
				                GoldPath & "\fact_product_nutrition.parquet"
				            )
				        ),
				    SelectedColumns =
				        Table.SelectColumns(
				            Source,
				            {
				                "product_key",
				                "shop_key",
				                "date_key",
				                "nutrient_key",
				                "nutrition_basis",
				                "nutrient_value",
				                "is_value_usable",
				                "is_latest_observation"
				            }
				        )
				in
				    SelectedColumns

