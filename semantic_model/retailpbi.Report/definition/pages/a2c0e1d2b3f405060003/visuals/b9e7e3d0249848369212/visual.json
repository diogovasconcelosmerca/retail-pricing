        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Method rules",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#252638",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Like-for-like: same product, same store or national price, compared with the same week 52 weeks earlier; geometric mean of price relatives.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#5D6375"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Every price number needs at least 500 matched pairs, so the ±10% perturbation averages out.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#5D6375"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Paid price = promo price when on promotion; shelf price = regular price. Paid minus shelf = promotion effect.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#5D6375"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Non-FMCG merchandise is excluded from price KPIs.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#5D6375"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Observed is not listed: products appearing or disappearing are partly data collection.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#5D6375"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Not claimed: sales, volumes, margins, price per kg, launches or delistings.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#5D6375"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
